#!/usr/bin/env bash

set -u -o pipefail

source "$(dirname "$0")/lab-common"
cd "$lab_repository_root" || exit 1

failures=0
decoy_pid=""
toxiproxy_url=""
temporary_directory=$(mktemp -d)

record_failure() {
  printf 'FAIL: %s\n' "$1" >&2
  failures=$((failures + 1))
}

remove_test_toxic() {
  if [[ -n "$toxiproxy_url" ]]; then
    TOXIPROXY_URL="$toxiproxy_url" toxiproxy-cli toxic remove \
      --toxicName pricing_latency pricing >/dev/null 2>&1 || true
  fi
}

cleanup() {
  if [[ -n "$decoy_pid" ]]; then
    kill "$decoy_pid" >/dev/null 2>&1 || true
    wait "$decoy_pid" >/dev/null 2>&1 || true
  fi
  remove_test_toxic
  rm --recursive --force -- "$temporary_directory"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

for command in bash curl docker jq node sha256sum timeout toxiproxy-cli; do
  if ! command -v "$command" >/dev/null 2>&1; then
    record_failure "$command is not available; reopen this repository in its devcontainer"
  fi
done

if command -v docker >/dev/null 2>&1 && \
  ! docker compose version >/dev/null 2>&1; then
  record_failure "Docker Compose is not available; reopen this repository in its devcontainer"
fi

for path in \
  .lab-fixtures.sha256 \
  compose.yml \
  lab08/experiment.sh \
  src/app.js \
  src/pricing.js \
  toxiproxy/toxiproxy.json; do
  if [[ ! -f "$path" ]]; then
    record_failure "$path is missing"
  fi
done

if [[ -f .lab-fixtures.sha256 ]] && \
  ! sha256sum --check --quiet .lab-fixtures.sha256; then
  record_failure "an instructor-owned stack, service, or support file was changed"
fi

experiment_valid=true
if [[ ! -x lab08/experiment.sh ]]; then
  record_failure "lab08/experiment.sh is not executable"
  experiment_valid=false
elif ! bash -n lab08/experiment.sh; then
  record_failure "lab08/experiment.sh is not valid Bash"
  experiment_valid=false
fi

if ((failures > 0)); then
  printf '\nLab check stopped because required files or tools are unavailable.\n' >&2
  exit 1
fi

printf 'Starting the pinned lab stack...\n'
stack_started=false
if ! docker compose up --detach --build --force-recreate --wait; then
  record_failure "the Docker Compose stack did not become healthy"
else
  stack_started=true
fi

lab_host=""
if [[ "$stack_started" == true ]]; then
  lab_host=$(wait_for_lab_host 3000 /health 10 || true)
  if [[ -z "$lab_host" ]]; then
    record_failure "checkout is not reachable from the devcontainer"
  elif ! curl --noproxy '*' --fail --silent --max-time 1 \
    "http://${lab_host}:8474/version" >/dev/null 2>&1; then
    record_failure "the Toxiproxy administration API is not reachable from the devcontainer"
  else
    toxiproxy_url="http://${lab_host}:8474"
  fi
fi

toxic_is_absent() {
  curl --noproxy '*' --fail --silent --max-time 2 \
    "$toxiproxy_url/proxies/pricing" | \
    jq --exit-status \
      '[.toxics[]? | select(.name == "pricing_latency")] | length == 0' \
      >/dev/null
}

if [[ "$experiment_valid" == true && -n "$toxiproxy_url" && -n "$lab_host" ]]; then
  printf '\nChecking the fault experiment...\n'
  remove_test_toxic
  if ! timeout 20 env \
    BASE_URL="http://${lab_host}:3000" \
    TOXIPROXY_URL="$toxiproxy_url" \
    TOXIPROXY_PROXY=pricing \
    TOXIPROXY_LATENCY_MS=2500 \
    bash lab08/experiment.sh >"$temporary_directory/experiment.log" 2>&1; then
    record_failure "the experiment did not establish healthy, delayed, and recovered behavior"
    sed -n '1,100p' "$temporary_directory/experiment.log" >&2
  else
    printf 'PASS: the experiment accepts the supplied fault behavior\n'
  fi

  if ! toxic_is_absent; then
    record_failure "the experiment left pricing_latency active after its normal run"
    remove_test_toxic
  else
    printf 'PASS: the experiment cleans up after its normal run\n'
  fi

  decoy_port=$(node - <<'NODE'
"use strict";
const net = require("node:net");
const server = net.createServer();
server.listen(0, "127.0.0.1", () => {
  console.log(server.address().port);
  server.close();
});
NODE
)
  PORT="$decoy_port" node -e '
    const http = require("node:http");
    const body = JSON.stringify({ total: 25, status: "ok" });
    http.createServer((_request, response) => {
      response.writeHead(200, { "content-type": "application/json" });
      response.end(body);
    }).listen(Number(process.env.PORT), "127.0.0.1");
  ' >"$temporary_directory/decoy.log" 2>&1 &
  decoy_pid=$!

  decoy_ready=false
  for _ in {1..20}; do
    if curl --noproxy '*' --fail --silent --max-time 0.5 \
      "http://127.0.0.1:${decoy_port}/checkout" >/dev/null 2>&1; then
      decoy_ready=true
      break
    fi
    sleep 0.1
  done

  remove_test_toxic
  if [[ "$decoy_ready" != true ]]; then
    record_failure "the checker could not start its always-healthy control service"
  elif timeout 20 env \
    BASE_URL="http://127.0.0.1:${decoy_port}" \
    TOXIPROXY_URL="$toxiproxy_url" \
    TOXIPROXY_PROXY=pricing \
    TOXIPROXY_LATENCY_MS=2500 \
    bash lab08/experiment.sh \
    >"$temporary_directory/experiment-control.log" 2>&1; then
    record_failure "the experiment accepted a service that stayed healthy during the fault"
  else
    printf 'PASS: the experiment rejects the always-healthy control\n'
  fi

  if ! toxic_is_absent; then
    record_failure "the experiment left pricing_latency active after an assertion failure"
    remove_test_toxic
  else
    printf 'PASS: the experiment cleans up after an assertion failure\n'
  fi
fi

printf '\n'
if ((failures > 0)); then
  printf 'Lab check failed with %d problem(s).\n' "$failures" >&2
  exit 1
fi

printf 'All Lab 8 checks passed.\n'
